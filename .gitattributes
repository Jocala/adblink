# Auto-detect text files and normalize to LF
* text=auto eol=lf

# Explicitly declare all your text/source files
*.cpp     text eol=lf
*.h       text eol=lf
*.c       text eol=lf
*.hpp     text eol=lf
*.hh      text eol=lf
*.html    text eol=lf
*.htm     text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.sh      text eol=lf
*.py      text eol=lf
*.xml     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Binary files (Git will not mess with line endings)
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.pdf     binary
*.exe     binary
*.dll     binary
*.so      binary
*.dylib   binary
